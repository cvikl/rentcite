# Model provider for Module A (extraction): gemini (default), anthropic or claude_cli.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   (with LLM_PROVIDER=anthropic and LLM_MODEL=claude-sonnet-5)
# Content-addressed cache of every model call (the audit log). 1 = replay from cache when available.
HOMERULE_CACHE=1
