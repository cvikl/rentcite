# Model provider for Module A (extraction). gemini is the default; anthropic and claude_cli also work.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Content-addressed cache of every model call (the audit log). 1 = replay from cache when available.
HOMERULE_CACHE=1
